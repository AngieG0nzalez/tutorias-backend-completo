# PostgreSQL / Supabase
user=postgres.xxxxxxxxx
password=TU_PASSWORD
host=TU_HOST_DE_SUPABASE
port=5432
dbname=postgres

# JWT
secret_key=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
algorithm=HS256
access_token_expire_minutes=60


#Recuperacion de contraseña y SMTP
SMTP_HOST=HOST_DEL_PROVEEDOR
SMTP_PORT=587
SMTP_USER=USUARIO_SMTP
SMTP_PASSWORD=CONTRASENA_SMTP
SMTP_FROM="Nexo <remitente@dominio-autorizado.com>"
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (sin barra final)
CORS_ORIGINS=http://localhost:5173

# IA local (Etapa 23): solo desarrollo local con Ollama. En produccion dejar false.
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30
AI_MAX_EXPLANATION_CHARS=1800
AI_MAX_DRAFT_CHARS=4500

# IA en la nube (Ollama Cloud, de pago) con respaldo en Ollama local si AI_ENABLED=true.
# Para la demo en Render: AI_ENABLED=false (sin local) y AI_CLOUD_ENABLED=true.
AI_CLOUD_ENABLED=false
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# Nombre exacto del modelo en https://ollama.com/api/tags (elige el más económico)
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_TIMEOUT_SECONDS=30
# Tope diario global de llamadas a la nube; al agotarse usa el local o responde 503
AI_CLOUD_DAILY_LIMIT=200
OLLAMA_API_KEY=
