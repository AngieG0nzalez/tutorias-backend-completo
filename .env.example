# PostgreSQL / Supabase
user=postgres.xxxxxxxxx
password=TU_PASSWORD
host=TU_HOST_DE_SUPABASE
port=5432
dbname=postgres

# JWT
secret_key=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
algorithm=HS256
access_token_expire_minutes=60


#Recuperacion de contraseña y SMTP
SMTP_HOST=HOST_DEL_PROVEEDOR
SMTP_PORT=587
SMTP_USER=USUARIO_SMTP
SMTP_PASSWORD=CONTRASENA_SMTP
# Render Free bloquea SMTP (puertos 25/465/587): usa la API HTTPS de Brevo.
# Si SMTP_PASSWORD ya es una clave de API de Brevo (empieza por xkeysib-), se usa sin más cambios.
# Una clave SMTP (xsmtpsib-) NO sirve para la API: crea una API key en Brevo.
# Si defines BREVO_API_KEY (Brevo -> SMTP & API -> API Keys), se usa la API y se ignoran SMTP_HOST/PORT/USER/PASSWORD.
# SMTP_FROM debe ser un remitente verificado en Brevo.
BREVO_API_KEY=
SMTP_FROM="Nexo <remitente@dominio-autorizado.com>"
# Dominio del frontend, sin barra final ni ruta. Los enlaces de los correos se arman con él.
# Producción (Render): FRONTEND_URL=https://nexo-frontend-rho.vercel.app
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (sin barra final).
# Producción (Render): CORS_ORIGINS=https://nexo-frontend-rho.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ======================= IA: ELIGE UN MODO =======================
# Orden de uso: 1) nube (si AI_CLOUD_ENABLED=true)  2) local (si AI_ENABLED=true)  3) sin IA.
# El local es respaldo: solo se usa si la nube falla o se agota el tope diario.
#
# MODO LOCAL (pruebas en tu Mac, NO gasta tokens de la nube):
#   AI_ENABLED=true
#   AI_CLOUD_ENABLED=false
#   (necesita Ollama abierto y `ollama pull qwen2.5:7b`)
#
# MODO PRODUCCIÓN / DEMO (Render, nube de pago):
#   AI_CLOUD_ENABLED=true
#   OLLAMA_API_KEY=<tu clave>, OLLAMA_CLOUD_MODEL=<modelo>
#   AI_ENABLED=false   (Render no puede alcanzar el Ollama de tu Mac)
#
# MODO NUBE + RESPALDO LOCAL (solo en tu Mac): AI_CLOUD_ENABLED=true y AI_ENABLED=true.
# En pruebas locales deja AI_CLOUD_ENABLED=false (o OLLAMA_API_KEY vacía) para no consumir créditos.

# --- IA local (Ollama en tu Mac) ---
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30
AI_MAX_EXPLANATION_CHARS=1800
AI_MAX_DRAFT_CHARS=4500

# --- IA en la nube (Ollama Cloud, de pago) ---
# Apagada por defecto: así ningún entorno local gasta créditos sin querer.
AI_CLOUD_ENABLED=false
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# Nombre exacto del modelo en https://ollama.com/api/tags (por ejemplo deepseek-v4.1-flash)
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_TIMEOUT_SECONDS=30
# Tope diario global de llamadas a la nube; al agotarse usa el local o responde 503
AI_CLOUD_DAILY_LIMIT=200
# Clave de https://ollama.com/settings/keys. Va en Render (Environment) o en tu .env local
# (ignorado por git). Nunca la pongas en este archivo ni en el frontend.
OLLAMA_API_KEY=
